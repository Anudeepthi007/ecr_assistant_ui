# ---------------------------------------------------------------------------
# ECR Intelligence Agent - environment template
# Copy to .env (repo root) or backend/.env and fill in what you need.
# The platform runs fully in DEMO MODE with none of these set.
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- Data ------------------------------------------------------------------
# All data lives in CSV files, one per table (backend/data by default). The app
# loads them at startup and writes every change back to them.
# DATA_DIR=C:/path/to/data

# --- LLM provider ----------------------------------------------------------
# mock | openai | anthropic | azure_openai | auto  ("auto" picks by key presence)
LLM_PROVIDER=auto
# false (default): the LLM writes only the answer and the defect summary, so an
# analysis takes seconds. true: it also rewords every step (about 7 more calls).
LLM_NARRATION=false

# OpenAI (or any OpenAI-compatible gateway, e.g. an enterprise LLM gateway)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Vector search ---------------------------------------------------------
# memory | pgvector | chroma
VECTOR_STORE=memory
# Must match the embedding model in use (1024 = Titan v2 / local hashed default)
EMBEDDING_DIM=1024

# --- Agent runtime ---------------------------------------------------------
AGENT_STEP_DELAY_MS=0
HUMAN_IN_THE_LOOP=false

# --- Test selection weights (must sum to 1.0) ------------------------------
TEST_WEIGHT_REQUIREMENT_MATCH=0.30
TEST_WEIGHT_COMPONENT_MATCH=0.25
TEST_WEIGHT_DEPENDENCY_RELEVANCE=0.15
TEST_WEIGHT_HISTORICAL_FAILURE=0.15
TEST_WEIGHT_SEMANTIC_SIMILARITY=0.15
TEST_SELECTION_THRESHOLD=50

# --- Security --------------------------------------------------------------
# When set, every /api call must send X-API-Key
API_KEY=
CORS_ORIGINS=*

# --- Frontend --------------------------------------------------------------
REACT_APP_BACKEND_URL=http://localhost:8000
